# ===========================================
# EduSphere AI Environment Configuration
# ===========================================
# IMPORTANT: This file contains variable NAMES only, not actual secrets.
# Copy this file to .env.local and fill in real values for local development.
# NEVER commit .env.local or any file containing real credentials.

# ===========================================
# PUBLIC / BROWSER-SAFE VARIABLES
# ===========================================
# These variables are prefixed with NEXT_PUBLIC_ and are embedded
# in the browser bundle. They are safe to expose to clients.

# Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Application configuration
NEXT_PUBLIC_APP_NAME=EduSphere AI
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ===========================================
# SERVER-ONLY SECRET VARIABLES
# ===========================================
# These variables are NOT prefixed with NEXT_PUBLIC_ and are only
# available in server-side code (API routes, Server Components, etc.)
# NEVER expose these to the browser.

# Supabase service role key (full database access - server only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database connection (if direct access needed - server only)
DATABASE_URL=postgresql://user:password@host:port/database

# External API keys (server only)
# AI_API_KEY=your-ai-provider-key-here
# EMAIL_API_KEY=your-email-provider-key-here
# SIGNATURE_API_KEY=your-signature-provider-key-here

# Session/JWT secret (server only)
# JWT_SECRET=your-jwt-secret-here

# ===========================================
# ENVIRONMENT
# ===========================================
# NODE_ENV is automatically set by Next.js
# development | production | test
